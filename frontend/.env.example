# Empty = relative URLs -> Vite dev server proxies /api to http://127.0.0.1:8000;
# in Docker, Nginx proxies /api to the backend container (same origin, no CORS).
# Only set this to an absolute origin (e.g. http://localhost) if the backend is
# NOT reachable through the /api proxy on the same origin.
VITE_API_BASE_URL=http://localhost
